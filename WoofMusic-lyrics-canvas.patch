@@ -0,0 +1,188 @@
+//
+//  LyricsTTML.swift
+//  Trop
+//
+//  Apple-style TTML — the format Better Lyrics, lrc.red and Unison answer with.
+//  Every <p> is a line, every <span> inside it a syllable, a span marked
+//  ttm:role="x-bg" holds backing vocals, and a second <p> per line carries the
+//  translation (same itunes:key, or the same begin time).
+//
+
+import Foundation
+
+enum LyricsTTML {
+    /// Parses a TTML document into timed lines. Never throws: a broken document
+    /// gives back whatever was read before the error.
+    static func parse(_ xml: String) -> [LyricLine] {
+        guard let data = xml.data(using: .utf8), !data.isEmpty else { return [] }
+        let reader = Reader()
+        let parser = XMLParser(data: data)
+        parser.delegate = reader
+        parser.shouldProcessNamespaces = true
+        _ = parser.parse()
+        return reader.result()
+    }
+
+    /// "12.5", "12.5s", "0:12.500" and "1:02:03.400" → seconds.
+    static func seconds(_ raw: String?) -> TimeInterval? {
+        guard var text = raw?.trimmingCharacters(in: .whitespacesAndNewlines), !text.isEmpty else { return nil }
+        if text.hasSuffix("s") { text.removeLast() }
+        let parts = text.split(separator: ":", omittingEmptySubsequences: false)
+        guard !parts.isEmpty, parts.count <= 3 else { return nil }
+        var value: TimeInterval = 0
+        for part in parts {
+            guard let number = Double(part.replacingOccurrences(of: ",", with: ".")), number.isFinite else { return nil }
+            value = value * 60 + number
+        }
+        return value >= 0 ? value : nil
+    }
+}
+
+// MARK: - Reading
+
+private final class Reader: NSObject, XMLParserDelegate {
+    /// A <p> being read, or a finished one.
+    private struct Line {
+        var key: String?
+        var begin: TimeInterval?
+        var end: TimeInterval?
+        var isTranslation = false
+        var words: [LyricWord] = []
+        /// Text that sits outside any timed span: the spaces between syllables.
+        var loose = ""
+
+        var text: String {
+            words.isEmpty
+                ? loose.trimmingCharacters(in: .whitespacesAndNewlines)
+                : words.map(\.text).joined().trimmingCharacters(in: .whitespacesAndNewlines)
+        }
+    }
+
+    private var finished: [Line] = []
+    private var line: Line?
+    /// One entry per open <span>: the word index it writes into, when it is timed.
+    private var spans: [Int?] = []
+    private var translationDepth = 0
+
+    // MARK: XMLParserDelegate
+
+    func parser(_ parser: XMLParser, didStartElement elementName: String, namespaceURI: String?,
+                qualifiedName qName: String?, attributes attributeDict: [String: String] = [:]) {
+        switch elementName {
+        case "p":
+            flush()
+            var opened = Line()
+            opened.begin = LyricsTTML.seconds(attributeDict["begin"])
+            opened.end = LyricsTTML.seconds(attributeDict["end"])
+            opened.key = attributeDict["key"] ?? attributeDict["id"]
+            let role = attributeDict["role"] ?? ""
+            opened.isTranslation = translationDepth > 0 || role.contains("translation")
+            line = opened
+            spans = []
+        case "div":
+            if (attributeDict["role"] ?? "").contains("translation") { translationDepth += 1 }
+        case "span":
+            guard var current = line else { return }
+            if let begin = LyricsTTML.seconds(attributeDict["begin"]) {
+                current.words.append(LyricWord(text: "", startTime: begin,
+                                               endTime: LyricsTTML.seconds(attributeDict["end"])))
+                line = current
+                spans.append(current.words.count - 1)
+            } else {
+                // An untimed wrapper (backing vocals hang their timed spans under it).
+                spans.append(nil)
+            }
+        case "br":
+            append(" ")
+        default:
+            break
+        }
+    }
+
+    func parser(_ parser: XMLParser, didEndElement elementName: String, namespaceURI: String?,
+                qualifiedName qName: String?) {
+        switch elementName {
+        case "p":
+            flush()
+        case "div":
+            if translationDepth > 0 { translationDepth -= 1 }
+        case "span":
+            if !spans.isEmpty { spans.removeLast() }
+        default:
+            break
+        }
+    }
+
+    func parser(_ parser: XMLParser, foundCharacters string: String) {
+        append(string)
+    }
+
+    func parser(_ parser: XMLParser, foundCDATA CDATABlock: Data) {
+        append(String(decoding: CDATABlock, as: UTF8.self))
+    }
+
+    // MARK: Pieces
+
+    private func append(_ text: String) {
+        guard !text.isEmpty, var current = line else { return }
+        if let index = spans.last ?? nil, current.words.indices.contains(index) {
+            current.words[index].text += text
+        } else if !current.words.isEmpty {
+            // A space between two syllables belongs to the syllable before it,
+            // so the line keeps its spacing without extra runs.
+            current.words[current.words.count - 1].text += text
+        } else {
+            current.loose += text
+        }
+        line = current
+    }
+
+    private func flush() {
+        guard var current = line else { return }
+        line = nil
+        spans = []
+        current.words.removeAll { $0.text.isEmpty }
+        if !current.words.isEmpty {
+            current.words[0].text = String(current.words[0].text.drop(while: \.isWhitespace))
+            let last = current.words.count - 1
+            while let character = current.words[last].text.last, character.isWhitespace {
+                current.words[last].text.removeLast()
+            }
+        }
+        guard !current.text.isEmpty else { return }
+        finished.append(current)
+    }
+
+    // MARK: Result
+
+    func result() -> [LyricLine] {
+        flush()
+        let originals = finished.filter { !$0.isTranslation }
+        let translations = finished.filter { $0.isTranslation }
+
+        var byKey: [String: String] = [:]
+        var byBegin: [TimeInterval: String] = [:]
+        for translation in translations where !translation.text.isEmpty {
+            if let key = translation.key { byKey[key] = translation.text }
+            if let begin = translation.begin { byBegin[begin] = translation.text }
+        }
+        // Some documents list translations in line order without keys or times.
+        let positional = translations.count == originals.count ? translations : []
+
+        return originals.enumerated().compactMap { offset, original -> LyricLine? in
+            let text = original.text
+            guard !text.isEmpty else { return nil }
+            var translation = original.key.flatMap { byKey[$0] } ?? original.begin.flatMap { byBegin[$0] }
+            if translation == nil, positional.indices.contains(offset) {
+                let candidate = positional[offset].text
+                translation = candidate.isEmpty ? nil : candidate
+            }
+            return LyricLine(
+                text: text,
+                startTime: original.begin,
+                words: original.words.isEmpty ? nil : original.words,
+                translation: translation == text ? nil : translation
+            )
+        }
+    }
+}
diff --git a/Trop/Audio/Lyrics/Providers/PaxsenixProvider.swift b/Trop/Audio/Lyrics/Providers/PaxsenixProvider.swift
new file mode 100644
index 0000000..1e5a337
--- /dev/null
+++ b/Trop/Audio/Lyrics/Providers/PaxsenixProvider.swift
@@ -0,0 +1,221 @@
+//
+//  PaxsenixProvider.swift
+//  Trop
+//
+//  Paxsenix (api.paxsenix.org) proxies Apple Music's own lyrics: a search
+//  returns catalogue ids, then one id brings word-by-word lyrics. It is the
+//  only source here that needs an account key, so it stays silent until one is
+//  pasted in Settings → Lyrics.
+//
+//  The host's answers are only loosely documented, so the response is read
+//  structurally rather than by a fixed schema: a TTML document is parsed as
+//  TTML, Apple's richsync shape (timestamp plus timed pieces) is rebuilt into
+//  word timings, and anything else falls back to the LRC/plain text a string
+//  field carries. A miss throws instead of inventing lines.
+//
+
+import Foundation
+
+extension LyricsAPIKeys {
+    static let paxsenixDefaultsKey = "settings.paxsenixAPIKey"
+
+    static var paxsenix: String? {
+        guard let key = UserDefaults.standard.string(forKey: paxsenixDefaultsKey)?
+            .trimmingCharacters(in: .whitespacesAndNewlines), !key.isEmpty else { return nil }
+        return key
+    }
+}
+
+struct PaxsenixProvider: LyricsProvider {
+    let id = "paxsenix"
+    let name = "Paxsenix"
+
+    private let baseURL = "https://api.paxsenix.org"
+
+    func fetch(query: LyricsQuery) async throws -> [LyricLine] {
+        guard let key = LyricsAPIKeys.paxsenix else { throw LyricsError.notFound }
+        guard let songID = try await searchID(key: key, query: query) else { throw LyricsError.notFound }
+
+        var components = URLComponents(string: baseURL + "/lyrics/applemusic")!
+        components.queryItems = [URLQueryItem(name: "id", value: songID)]
+        guard let url = components.url else { throw LyricsError.invalidURL }
+
+        var request = URLRequest(url: url)
+        request.timeoutInterval = 15
+        request.setValue("Bearer \(key)", forHTTPHeaderField: "Authorization")
+        request.setValue("application/json, text/plain, */*", forHTTPHeaderField: "Accept")
+
+        let data = try await LyricsHTTP.get(request)
+        guard let body = String(data: data, encoding: .utf8), !body.isEmpty else { throw LyricsError.notFound }
+
+        let lines = Self.parse(body)
+        guard !lines.isEmpty else { throw LyricsError.notFound }
+        return lines
+    }
+
+    // MARK: - Search
+
+    private func searchID(key: String, query: LyricsQuery) async throws -> String? {
+        var components = URLComponents(string: baseURL + "/apple-music/search")!
+        components.queryItems = [URLQueryItem(name: "q", value: "\(query.title) \(query.artist)")]
+        guard let url = components.url else { throw LyricsError.invalidURL }
+
+        var request = URLRequest(url: url)
+        request.timeoutInterval = 15
+        request.setValue("Bearer \(key)", forHTTPHeaderField: "Authorization")
+        request.setValue("application/json, text/plain, */*", forHTTPHeaderField: "Accept")
+
+        let data = try await LyricsHTTP.get(request)
+        guard let object = try? JSONSerialization.jsonObject(with: data) else { return nil }
+
+        var candidates: [Candidate] = []
+        Self.collectTracks(object, into: &candidates)
+        guard !candidates.isEmpty else { return nil }
+
+        let wantedTitle = Self.normalized(query.title)
+        let wantedArtist = Self.normalized(query.artist)
+
+        func score(_ candidate: Candidate) -> Double {
+            var value = 0.0
+            let title = Self.normalized(candidate.title)
+            if title == wantedTitle {
+                value += 5
+            } else if title.contains(wantedTitle) || wantedTitle.contains(title) {
+                value += 2
+            }
+            let artist = Self.normalized(candidate.artist)
+            if !wantedArtist.isEmpty, artist.contains(wantedArtist) || wantedArtist.contains(artist) {
+                value += 3
+            }
+            if title.contains("karaoke") || title.contains("tribute") || title.contains("instrumental") {
+                value -= 4
+            }
+            return value
+        }
+
+        return candidates
+            .map { ($0, score($0)) }
+            .max { $0.1 < $1.1 }
+            .flatMap { $0.1 > 0 ? $0.0.id : nil }
+    }
+
+    private struct Candidate {
+        let id: String
+        let title: String
+        let artist: String
+    }
+
+    /// Apple-shaped payloads nest the id under `data[].id`, others put it at the
+    /// top of each row, so every dictionary that carries an id and a name is
+    /// taken as a candidate wherever it sits.
+    private static func collectTracks(_ element: Any, into destination: inout [Candidate]) {
+        if let array = element as? [Any] {
+            for item in array { collectTracks(item, into: &destination) }
+            return
+        }
+        guard let object = element as? [String: Any] else { return }
+
+        let attributes = object["attributes"] as? [String: Any]
+        let id = firstString(in: object, keys: ["id", "songId", "trackId", "catalogId"])
+        let title = firstString(in: attributes ?? object, keys: ["name", "title", "trackName", "songName"])
+        if let id, let title, !id.isEmpty, !title.isEmpty {
+            let artist = firstString(in: attributes ?? object,
+                                     keys: ["artistName", "artist", "artist_name", "subtitle"]) ?? ""
+            destination.append(Candidate(id: id, title: title, artist: artist))
+        }
+
+        for value in object.values { collectTracks(value, into: &destination) }
+    }
+
+    private static func firstString(in object: [String: Any], keys: [String]) -> String? {
+        for key in keys {
+            if let value = object[key] as? String {
+                let trimmed = value.trimmingCharacters(in: .whitespacesAndNewlines)
+                if !trimmed.isEmpty { return trimmed }
+            }
+        }
+        return nil
+    }
+
+    // MARK: - Response
+
+    static func parse(_ body: String) -> [LyricLine] {
+        if body.contains("<tt") {
+            let lines = LyricsTTML.parse(body)
+            if !lines.isEmpty { return lines }
+        }
+
+        guard let data = body.data(using: .utf8),
+              let object = try? JSONSerialization.jsonObject(with: data) else {
+            return LyricsParsing.parseStoredText(body)
+        }
+
+        if let richsync = appleLines(in: object), !richsync.isEmpty { return richsync }
+        if let text = firstLyricsString(in: object) {
+            let lines = LyricsParsing.parseStoredText(text)
+            if !lines.isEmpty { return lines }
+        }
+        return []
+    }
+
+    /// Apple's richsync shape: `content` of `{ timestamp, text: [{ text }] }`,
+    /// timestamps in milliseconds.
+    private static func appleLines(in element: Any) -> [LyricLine]? {
+        guard let object = element as? [String: Any] else {
+            if let array = element as? [Any] {
+                for item in array {
+                    if let found = appleLines(in: item) { return found }
+                }
+            }
+            return nil
+        }
+
+        if let content = object["content"] as? [[String: Any]] {
+            let lines: [LyricLine] = content.compactMap { entry in
+                guard let timestamp = (entry["timestamp"] as? NSNumber)?.doubleValue else { return nil }
+                let pieces = entry["text"] as? [[String: Any]] ?? []
+                let words: [LyricWord] = pieces.compactMap { piece in
+                    guard let text = piece["text"] as? String else { return nil }
+                    return LyricWord(text: text, startTime: timestamp / 1000)
+                }
+                let joined = words.map(\.text).joined()
+                guard !joined.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else { return nil }
+                var line = LyricLine(text: joined, startTime: timestamp / 1000)
+                line.words = words.isEmpty ? nil : words
+                return line
+            }
+            if !lines.isEmpty { return lines }
+        }
+
+        for value in object.values {
+            if let found = appleLines(in: value) { return found }
+        }
+        return nil
+    }
+
+    private static func firstLyricsString(in element: Any) -> String? {
+        if let object = element as? [String: Any] {
+            for key in ["lyrics", "lrc", "syncedLyrics", "plainLyrics", "lines", "line", "text", "content"] {
+                if let value = object[key] as? String, value.count > 12, value.contains("\n") {
+                    return value
+                }
+            }
+            for value in object.values {
+                if let found = firstLyricsString(in: value) { return found }
+            }
+            return nil
+        }
+        if let array = element as? [Any] {
+            for item in array {
+                if let found = firstLyricsString(in: item) { return found }
+            }
+        }
+        return nil
+    }
+
+    private static func normalized(_ text: String) -> String {
+        let lowered = text.lowercased()
+        let allowed = lowered.unicodeScalars.filter { CharacterSet.alphanumerics.contains($0) || $0 == " " }
+        return String(String.UnicodeScalarView(allowed)).trimmingCharacters(in: .whitespaces)
+    }
+}
diff --git a/Trop/Audio/Lyrics/Providers/UnisonProvider.swift b/Trop/Audio/Lyrics/Providers/UnisonProvider.swift
new file mode 100644
index 0000000..4be6898
--- /dev/null
+++ b/Trop/Audio/Lyrics/Providers/UnisonProvider.swift
@@ -0,0 +1,67 @@
+//
+//  UnisonProvider.swift
+//  Trop
+//
+//  Unison (https://docs.betterlyrics.org/unison) is community-submitted lyrics
+//  keyed by video id — the one id WoofMusic already has — and answers in TTML,
+//  LRC or plain text. No key, 600 reads a minute per address.
+//
+
+import Foundation
+
+struct UnisonProvider: LyricsProvider {
+    let id = "unison"
+    let name = "Unison"
+
+    private let baseURL = "https://unison.betterlyrics.org/lyrics"
+
+    private struct Envelope: Decodable {
+        struct Payload: Decodable {
+            let lyrics: String
+            let format: String
+            let syncType: String?
+        }
+
+        let success: Bool
+        let data: Payload?
+    }
+
+    func fetch(query: LyricsQuery) async throws -> [LyricLine] {
+        var components = URLComponents(string: baseURL)!
+        var items: [URLQueryItem] = []
+
+        if let videoId = query.videoId, !videoId.isEmpty {
+            items.append(URLQueryItem(name: "v", value: videoId))
+        }
+        items.append(URLQueryItem(name: "song", value: query.title))
+        items.append(URLQueryItem(name: "artist", value: query.artist))
+        if let album = query.album, !album.isEmpty {
+            items.append(URLQueryItem(name: "album", value: album))
+        }
+        if query.durationSeconds > 0 {
+            items.append(URLQueryItem(name: "duration", value: String(query.durationSeconds)))
+        }
+        components.queryItems = items
+
+        guard let url = components.url else { throw LyricsError.invalidURL }
+        var request = URLRequest(url: url)
+        request.timeoutInterval = 12
+
+        let envelope = try await LyricsHTTP.decoded(Envelope.self, request)
+        guard envelope.success, let payload = envelope.data, !payload.lyrics.isEmpty else {
+            throw LyricsError.notFound
+        }
+
+        let lines: [LyricLine]
+        switch payload.format.lowercased() {
+        case "ttml":
+            lines = LyricsTTML.parse(payload.lyrics)
+        case "lrc":
+            lines = LyricsParsing.parseStoredText(payload.lyrics)
+        default:
+            lines = LyricsText.plainLines(payload.lyrics)
+        }
+        guard !lines.isEmpty else { throw LyricsError.notFound }
+        return lines
+    }
+}
diff --git a/Trop/Audio/Lyrics/Translation/AITranslator.swift b/Trop/Audio/Lyrics/Translation/AITranslator.swift
new file mode 100644
index 0000000..fc0a2e5
--- /dev/null
+++ b/Trop/Audio/Lyrics/Translation/AITranslator.swift
@@ -0,0 +1,241 @@
+//
+//  AITranslator.swift
+//  Trop
+//
+//  Network translation for lyrics. One prompt shape for every engine: a JSON
+//  array of lines in, a JSON object with the same number of lines out. Apple's
+//  on-device engine is not handled here — the view drives it through
+//  TranslationSession — so this is the "the rest" of the picker.
+//
+
+import Foundation
+
+enum AITranslationError: Error, LocalizedError {
+    case missingKey
+    case badResponse(Int, String)
+    case unparsable
+
+    var errorDescription: String? {
+        switch self {
+        case .missingKey:
+            return "No API key for the chosen translator."
+        case .badResponse(let code, let body):
+            let trimmed = body.trimmingCharacters(in: .whitespacesAndNewlines)
+            let detail = trimmed.count > 180 ? String(trimmed.prefix(180)) + "…" : trimmed
+            return "HTTP \(code): \(detail)"
+        case .unparsable:
+            return "The translator's answer could not be read."
+        }
+    }
+}
+
+enum AITranslator {
+    /// Lines per request: enough for the model to keep the song's context,
+    /// small enough that the answer never gets truncated or merged.
+    private static let batchSize = 40
+
+    /// Returns one translation per input line, in the same order. Empty input
+    /// lines stay empty, so the caller can map by index without bookkeeping.
+    static func translate(lines: [String], to language: String) async throws -> [String] {
+        let engine = TranslationSettings.engine
+        guard engine != .apple else { return lines }
+
+        var result = [String](repeating: "", count: lines.count)
+        let wanted = lines.enumerated().filter {
+            !$0.element.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty
+        }
+        guard !wanted.isEmpty else { return result }
+
+        var cursor = 0
+        while cursor < wanted.count {
+            let slice = Array(wanted[cursor..<min(cursor + batchSize, wanted.count)])
+            let texts = slice.map { $0.element }
+            let translated = try await request(engine: engine, texts: texts, language: language)
+            for (offset, item) in slice.enumerated() where translated.indices.contains(offset) {
+                result[item.offset] = translated[offset]
+            }
+            cursor += batchSize
+        }
+        return result
+    }
+
+    // MARK: - Engines
+
+    private static func request(
+        engine: TranslationEngine,
+        texts: [String],
+        language: String
+    ) async throws -> [String] {
+        switch engine {
+        case .openAI, .openRouter, .custom:
+            return try await chat(engine: engine, texts: texts, language: language)
+        case .google:
+            return try await google(texts: texts, language: language)
+        case .anthropic:
+            return try await anthropic(texts: texts, language: language)
+        case .apple:
+            return texts
+        }
+    }
+
+    private static func chat(
+        engine: TranslationEngine,
+        texts: [String],
+        language: String
+    ) async throws -> [String] {
+        guard let key = TranslationSettings.key(for: engine) else { throw AITranslationError.missingKey }
+        let root = TranslationSettings.baseURL(for: engine)
+        guard !root.isEmpty else { throw AITranslationError.missingKey }
+        let path = root.hasSuffix("/") ? root + "chat/completions" : root + "/chat/completions"
+        guard let url = URL(string: path) else { throw AITranslationError.unparsable }
+
+        var request = URLRequest(url: url)
+        request.httpMethod = "POST"
+        request.timeoutInterval = 90
+        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+        request.setValue("Bearer \(key)", forHTTPHeaderField: "Authorization")
+        if engine == .openRouter {
+            request.setValue("Music+ for iOS", forHTTPHeaderField: "X-Title")
+            request.setValue("https://github.com/dmitrylol/WoofMusicPlus", forHTTPHeaderField: "HTTP-Referer")
+        }
+
+        let body: [String: Any] = [
+            "model": TranslationSettings.model(for: engine),
+            "temperature": 0,
+            "messages": [
+                ["role": "system", "content": instructions(language: language)],
+                ["role": "user", "content": payload(texts)]
+            ]
+        ]
+        request.httpBody = try JSONSerialization.data(withJSONObject: body)
+
+        let data = try await send(request)
+        guard let json = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
+              let choices = json["choices"] as? [[String: Any]],
+              let message = choices.first?["message"] as? [String: Any],
+              let content = message["content"] as? String else {
+            throw AITranslationError.unparsable
+        }
+        return try parse(content, expected: texts.count)
+    }
+
+    private static func google(texts: [String], language: String) async throws -> [String] {
+        guard let key = TranslationSettings.key(for: .google) else { throw AITranslationError.missingKey }
+        let model = TranslationSettings.model(for: .google)
+        let path = "https://generativelanguage.googleapis.com/v1beta/models/\(model):generateContent?key=\(key)"
+        guard let url = URL(string: path) else { throw AITranslationError.unparsable }
+
+        var request = URLRequest(url: url)
+        request.httpMethod = "POST"
+        request.timeoutInterval = 90
+        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+
+        let body: [String: Any] = [
+            "systemInstruction": ["parts": [["text": instructions(language: language)]]],
+            "contents": [
+                ["role": "user", "parts": [["text": payload(texts)]]]
+            ],
+            "generationConfig": [
+                "temperature": 0,
+                "responseMimeType": "application/json"
+            ]
+        ]
+        request.httpBody = try JSONSerialization.data(withJSONObject: body)
+
+        let data = try await send(request)
+        guard let json = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
+              let candidates = json["candidates"] as? [[String: Any]],
+              let content = candidates.first?["content"] as? [String: Any],
+              let parts = content["parts"] as? [[String: Any]] else {
+            throw AITranslationError.unparsable
+        }
+        let text = parts.compactMap { $0["text"] as? String }.joined()
+        return try parse(text, expected: texts.count)
+    }
+
+    private static func anthropic(texts: [String], language: String) async throws -> [String] {
+        guard let key = TranslationSettings.key(for: .anthropic) else { throw AITranslationError.missingKey }
+        guard let url = URL(string: "https://api.anthropic.com/v1/messages") else {
+            throw AITranslationError.unparsable
+        }
+
+        var request = URLRequest(url: url)
+        request.httpMethod = "POST"
+        request.timeoutInterval = 90
+        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+        request.setValue(key, forHTTPHeaderField: "x-api-key")
+        request.setValue("2023-06-01", forHTTPHeaderField: "anthropic-version")
+
+        let body: [String: Any] = [
+            "model": TranslationSettings.model(for: .anthropic),
+            "max_tokens": 8192,
+            "temperature": 0,
+            "system": instructions(language: language),
+            "messages": [
+                ["role": "user", "content": payload(texts)]
+            ]
+        ]
+        request.httpBody = try JSONSerialization.data(withJSONObject: body)
+
+        let data = try await send(request)
+        guard let json = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
+              let blocks = json["content"] as? [[String: Any]] else {
+            throw AITranslationError.unparsable
+        }
+        let text = blocks.compactMap { $0["text"] as? String }.joined()
+        return try parse(text, expected: texts.count)
+    }
+
+    // MARK: - Plumbing
+
+    private static func send(_ request: URLRequest) async throws -> Data {
+        let (data, response) = try await URLSession.shared.data(for: request)
+        guard let http = response as? HTTPURLResponse else { throw AITranslationError.unparsable }
+        guard (200..<300).contains(http.statusCode) else {
+            throw AITranslationError.badResponse(http.statusCode, String(data: data, encoding: .utf8) ?? "")
+        }
+        return data
+    }
+
+    private static func instructions(language: String) -> String {
+        """
+        You translate song lyrics. The user sends a JSON array of lyric lines. \
+        Translate every line into \(language). Keep the order and the number of \
+        items exactly, keep slang, names and the song's tone, never merge or \
+        split lines, never explain anything. Answer with one JSON object and \
+        nothing else, in this shape: {"lines": ["first line", "second line"]}
+        """
+    }
+
+    private static func payload(_ texts: [String]) -> String {
+        guard let data = try? JSONSerialization.data(withJSONObject: texts) else { return "[]" }
+        return String(data: data, encoding: .utf8) ?? "[]"
+    }
+
+    /// Reads the JSON object back, and falls back to one translation per row
+    /// for a model that ignored the shape but kept the count.
+    private static func parse(_ raw: String, expected: Int) throws -> [String] {
+        let cleaned = raw
+            .replacingOccurrences(of: "```json", with: "")
+            .replacingOccurrences(of: "```", with: "")
+            .trimmingCharacters(in: .whitespacesAndNewlines)
+
+        if let start = cleaned.firstIndex(of: "{"),
+           let end = cleaned.lastIndex(of: "}"),
+           start < end,
+           let data = String(cleaned[start...end]).data(using: .utf8),
+           let json = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
+           let array = json["lines"] as? [String],
+           array.count == expected {
+            return array
+        }
+
+        let rows = cleaned
+            .split(whereSeparator: \.isNewline)
+            .map { $0.trimmingCharacters(in: .whitespaces) }
+            .filter { !$0.isEmpty }
+        if rows.count == expected { return rows }
+
+        throw AITranslationError.unparsable
+    }
+}
diff --git a/Trop/Audio/Lyrics/Translation/TranslationSettings.swift b/Trop/Audio/Lyrics/Translation/TranslationSettings.swift
new file mode 100644
index 0000000..f2658a3
--- /dev/null
+++ b/Trop/Audio/Lyrics/Translation/TranslationSettings.swift
@@ -0,0 +1,159 @@
+//
+//  TranslationSettings.swift
+//  Trop
+//
+//  Which engine translates lyrics and how it is called. Apple's on-device
+//  translation stays the default because it costs nothing and needs no key;
+//  the network engines are opt-in and each keeps its own key and model id.
+//
+
+import Foundation
+
+enum TranslationEngine: String, CaseIterable, Identifiable {
+    case apple
+    case openAI
+    case openRouter
+    case google
+    case anthropic
+    case custom
+
+    var id: String { rawValue }
+
+    var title: String {
+        switch self {
+        case .apple: return "Apple (on device)"
+        case .openAI: return "OpenAI"
+        case .openRouter: return "OpenRouter"
+        case .google: return "Google Gemini"
+        case .anthropic: return "Anthropic Claude"
+        case .custom: return "Custom (OpenAI-compatible)"
+        }
+    }
+
+    var needsKey: Bool { self != .apple }
+
+    /// Endpoint root for the engines that speak the OpenAI chat API.
+    var defaultBaseURL: String? {
+        switch self {
+        case .openAI: return "https://api.openai.com/v1"
+        case .openRouter: return "https://openrouter.ai/api/v1"
+        case .custom: return ""
+        default: return nil
+        }
+    }
+
+    /// A starting point only. Model ids change on the provider's side, so the
+    /// field is editable and a 404 is fixed by typing the current one.
+    var defaultModel: String {
+        switch self {
+        case .apple: return ""
+        case .openAI: return "gpt-6.1"
+        case .openRouter: return "openai/gpt-6.1"
+        case .google: return "gemini-4-carbon"
+        case .anthropic: return "claude-sonnet-5-5"
+        case .custom: return ""
+        }
+    }
+
+    var keyHint: String {
+        switch self {
+        case .apple: return ""
+        case .openAI: return "platform.openai.com → API keys"
+        case .openRouter: return "openrouter.ai/keys"
+        case .google: return "aistudio.google.com → API key"
+        case .anthropic: return "console.anthropic.com → API keys"
+        case .custom: return "Any service that speaks the OpenAI chat API"
+        }
+    }
+}
+
+struct TranslationTarget: Identifiable, Hashable {
+    let id: String
+    let name: String
+}
+
+enum TranslationSettings {
+    private static let engineKey = "settings.translationEngine"
+    private static let targetKey = "settings.translationTarget"
+
+    /// A short list is enough: a listener translates into the language they
+    /// read, and a wrong guess is one tap away from being fixed.
+    static let targets: [TranslationTarget] = [
+        TranslationTarget(id: "auto", name: "Match the phone"),
+        TranslationTarget(id: "ru", name: "Russian"),
+        TranslationTarget(id: "en", name: "English"),
+        TranslationTarget(id: "uk", name: "Ukrainian"),
+        TranslationTarget(id: "kk", name: "Kazakh"),
+        TranslationTarget(id: "es", name: "Spanish"),
+        TranslationTarget(id: "de", name: "German"),
+        TranslationTarget(id: "fr", name: "French"),
+        TranslationTarget(id: "it", name: "Italian"),
+        TranslationTarget(id: "pt", name: "Portuguese"),
+        TranslationTarget(id: "tr", name: "Turkish"),
+        TranslationTarget(id: "ko", name: "Korean"),
+        TranslationTarget(id: "ja", name: "Japanese"),
+        TranslationTarget(id: "zh", name: "Chinese")
+    ]
+
+    static var engine: TranslationEngine {
+        get { TranslationEngine(rawValue: UserDefaults.standard.string(forKey: engineKey) ?? "") ?? .apple }
+        set { UserDefaults.standard.set(newValue.rawValue, forKey: engineKey) }
+    }
+
+    static var targetOption: String {
+        get { UserDefaults.standard.string(forKey: targetKey) ?? "auto" }
+        set { UserDefaults.standard.set(newValue, forKey: targetKey) }
+    }
+
+    /// BCP-47 identifier the translation runs into.
+    static var targetIdentifier: String {
+        targetOption == "auto" ? (Locale.preferredLanguages.first ?? "en") : targetOption
+    }
+
+    /// The same language as a name a model understands in a prompt.
+    static var targetName: String {
+        let identifier = targetIdentifier
+        return Locale(identifier: "en").localizedString(forIdentifier: identifier) ?? identifier
+    }
+
+    static func model(for engine: TranslationEngine) -> String {
+        let stored = UserDefaults.standard.string(forKey: "settings.translationModel.\(engine.rawValue)")?
+            .trimmingCharacters(in: .whitespacesAndNewlines)
+        guard let stored, !stored.isEmpty else { return engine.defaultModel }
+        return stored
+    }
+
+    static func setModel(_ model: String, for engine: TranslationEngine) {
+        UserDefaults.standard.set(
+            model.trimmingCharacters(in: .whitespacesAndNewlines),
+            forKey: "settings.translationModel.\(engine.rawValue)"
+        )
+    }
+
+    static func key(for engine: TranslationEngine) -> String? {
+        guard let value = UserDefaults.standard.string(forKey: "settings.translationKey.\(engine.rawValue)")?
+            .trimmingCharacters(in: .whitespacesAndNewlines), !value.isEmpty else { return nil }
+        return value
+    }
+
+    static func setKey(_ key: String, for engine: TranslationEngine) {
+        UserDefaults.standard.set(
+            key.trimmingCharacters(in: .whitespacesAndNewlines),
+            forKey: "settings.translationKey.\(engine.rawValue)"
+        )
+    }
+
+    static func baseURL(for engine: TranslationEngine) -> String {
+        let stored = UserDefaults.standard.string(forKey: "settings.translationBase.\(engine.rawValue)")?
+            .trimmingCharacters(in: .whitespacesAndNewlines)
+        if let stored, !stored.isEmpty { return stored }
+        return engine.defaultBaseURL ?? ""
+    }
+
+    static func setBaseURL(_ value: String, for engine: TranslationEngine) {
+        UserDefaults.standard.set(
+            value.trimmingCharacters(in: .whitespacesAndNewlines),
+            forKey: "settings.translationBase.\(engine.rawValue)"
+        )
+    }
+}
diff --git a/Trop/Cache/CacheManager.swift b/Trop/Cache/CacheManager.swift
new file mode 100644
index 0000000..fd3b735
--- /dev/null
+++ b/Trop/Cache/CacheManager.swift
@@ -0,0 +1,117 @@
+//
+//  CacheManager.swift
+//  Trop
+//
+//  One place that owns how much disk the app may use: Nuke's artwork cache,
+//  the HTTP cache, lyric translations and the clips imported from Photos.
+//  The limit is the listener's choice; every cache is measured against it.
+//
+
+import Foundation
+import Nuke
+
+enum CacheManager {
+    static let limitKey = "settings.cacheLimitMB"
+    static let defaultLimitMB = 2048
+    static let choices = [256, 512, 1024, 2048, 4096, 8192]
+
+    static var limitMB: Int {
+        let stored = UserDefaults.standard.object(forKey: limitKey) as? Int
+        return max(128, stored ?? defaultLimitMB)
+    }
+
+    static var limitBytes: Int64 { Int64(limitMB) * 1024 * 1024 }
+
+    /// Pushes the limit into both caches. Nuke owns cover art, URLCache owns
+    /// every other HTTP response, and both shrink when the listener picks a
+    /// smaller number.
+    static func applyLimits() {
+        let bytes = Int(min(limitBytes, Int64(Int.max)))
+        if let dataCache = ImagePipeline.shared.configuration.dataCache as? DataCache {
+            dataCache.sizeLimit = bytes
+        }
+        URLCache.shared = URLCache(
+            memoryCapacity: 32 * 1024 * 1024,
+            diskCapacity: bytes,
+            diskPath: "trop.http"
+        )
+    }
+
+    // MARK: - Measurement
+
+    static func usedBytes() -> Int64 {
+        directorySize(cachesDirectory) + directorySize(canvasDirectory)
+    }
+
+    static func canvasBytes() -> Int64 {
+        directorySize(canvasDirectory)
+    }
+
+    static func formatted(_ bytes: Int64) -> String {
+        let formatter = ByteCountFormatter()
+        formatter.allowedUnits = [.useMB, .useGB]
+        formatter.countStyle = .file
+        return formatter.string(fromByteCount: max(bytes, 0))
+    }
+
+    static func summary() -> String {
+        "\(formatted(usedBytes())) of \(formatted(limitBytes))"
+    }
+
+    // MARK: - Cleaning
+
+    static func clearArtwork() {
+        ImagePipeline.shared.configuration.dataCache?.removeAll()
+        URLCache.shared.removeAllCachedResponses()
+        trimCachesToLimit()
+    }
+
+    /// Deletes every imported clip and forgets the picks that pointed at them.
+    static func clearCanvases() {
+        let url = canvasDirectory
+        if let files = try? FileManager.default.contentsOfDirectory(at: url, includingPropertiesForKeys: nil) {
+            for file in files { try? FileManager.default.removeItem(at: file) }
+        }
+        UserDefaults.standard.removeObject(forKey: "canvas.picks.v2")
+        CanvasService.shared.forgetAll()
+    }
+
+    /// Drops whole caches when the listener lowers the limit below what is on disk.
+    static func trimCachesToLimit() {
+        guard usedBytes() > limitBytes else { return }
+        if canvasBytes() > limitBytes / 4 {
+            clearCanvases()
+        }
+        if usedBytes() > limitBytes {
+            ImagePipeline.shared.configuration.dataCache?.removeAll()
+            URLCache.shared.removeAllCachedResponses()
+        }
+    }
+
+    // MARK: - Paths
+
+    private static var cachesDirectory: URL {
+        FileManager.default.urls(for: .cachesDirectory, in: .userDomainMask)[0]
+    }
+
+    private static var canvasDirectory: URL {
+        FileManager.default.urls(for: .documentDirectory, in: .userDomainMask)[0]
+            .appendingPathComponent("Canvases", isDirectory: true)
+    }
+
+    private static func directorySize(_ url: URL) -> Int64 {
+        guard let enumerator = FileManager.default.enumerator(
+            at: url,
+            includingPropertiesForKeys: [.totalFileAllocatedSizeKey, .isRegularFileKey],
+            options: [.skipsHiddenFiles]
+        ) else { return 0 }
+
+        var total: Int64 = 0
+        for case let file as URL in enumerator {
+            let values = try? file.resourceValues(forKeys: [.totalFileAllocatedSizeKey, .isRegularFileKey])
+            guard values?.isRegularFile == true else { continue }
+            total += Int64(values?.totalFileAllocatedSize ?? 0)
+        }
+        return total
+    }
+}
diff --git a/Trop/Canvas/CanvasBackdrop.swift b/Trop/Canvas/CanvasBackdrop.swift
new file mode 100644
index 0000000..3ab4bc5
--- /dev/null
+++ b/Trop/Canvas/CanvasBackdrop.swift
@@ -0,0 +1,93 @@
+//
+//  CanvasBackdrop.swift
+//  Trop
+//
+//  The looping video layer that sits under the player. Muted, gapless, and
+//  invisible when the track has no clip — no black rectangle, no placeholder.
+//
+
+import AVFoundation
+import AVKit
+import SwiftUI
+
+struct CanvasBackdrop: View {
+    let videoId: String
+    let title: String
+    let artist: String
+    let album: String?
+    /// How dark the scrim over the video is; the lyrics need contrast.
+    var dim: Double = 0.4
+
+    @State private var player: AVQueuePlayer?
+    @State private var looper: AVPlayerLooper?
+
+    var body: some View {
+        ZStack {
+            if let player {
+                CanvasPlayerLayer(player: player)
+                Color.black.opacity(dim)
+            }
+        }
+        .allowsHitTesting(false)
+        .task(id: videoId) { await load() }
+        .onDisappear { stop() }
+    }
+
+    private func load() async {
+        stop()
+        guard !videoId.isEmpty else { return }
+        guard let url = await CanvasService.shared.canvas(videoId: videoId,
+                                                          title: title,
+                                                          artist: artist,
+                                                          album: album) else { return }
+
+        let item = AVPlayerItem(url: url)
+        item.preferredForwardBufferDuration = 2
+        let queue = AVQueuePlayer()
+        queue.isMuted = true
+        queue.actionAtItemEnd = .advance
+        queue.preventsDisplaySleepDuringVideoPlayback = false
+        // The looper keeps the clip seamless; HLS clips from the catalogue are
+        // short VODs, so it loops the same way a local file would.
+        let loop = AVPlayerLooper(player: queue, templateItem: item)
+        queue.play()
+
+        player = queue
+        looper = loop
+    }
+
+    private func stop() {
+        player?.pause()
+        player = nil
+        looper = nil
+    }
+}
+
+// MARK: - Layer
+
+private struct CanvasPlayerLayer: UIViewRepresentable {
+    let player: AVPlayer
+
+    func makeUIView(context: Context) -> PlayerView {
+        let view = PlayerView()
+        view.backgroundColor = .clear
+        view.playerLayer.videoGravity = .resizeAspectFill
+        view.playerLayer.player = player
+        return view
+    }
+
+    func updateUIView(_ view: PlayerView, context: Context) {
+        if view.playerLayer.player !== player {
+            view.playerLayer.player = player
+        }
+    }
+
+    final class PlayerView: UIView {
+        override static var layerClass: AnyClass { AVPlayerLayer.self }
+
+        var playerLayer: AVPlayerLayer {
+            // `layerClass` makes the backing layer an AVPlayerLayer.
+            layer as! AVPlayerLayer
+        }
+    }
+}
diff --git a/Trop/Canvas/CanvasPickerView.swift b/Trop/Canvas/CanvasPickerView.swift
new file mode 100644
index 0000000..a941a03
--- /dev/null
+++ b/Trop/Canvas/CanvasPickerView.swift
@@ -0,0 +1,194 @@
+//
+//  CanvasPickerView.swift
+//  Trop
+//
+//  The manual clip picker behind the "⋯ → Canvas…" item: search the catalogue
+//  for a still and a clip, or import a video from Photos. Either choice is
+//  stored per track and wins over both automatic sources.
+//
+
+import PhotosUI
+import SwiftUI
+import UniformTypeIdentifiers
+
+struct CanvasPickerView: View {
+    let videoId: String
+    let title: String
+    let artist: String
+    let album: String?
+
+    @Environment(\.dismiss) private var dismiss
+    @State private var query = ""
+    @State private var candidates: [CanvasCandidate] = []
+    @State private var isSearching = false
+    @State private var hasSearched = false
+    @State private var pickedItem: PhotosPickerItem?
+    @State private var isImporting = false
+    @State private var errorMessage: String?
+    @State private var hasPick = false
+
+    var body: some View {
+        NavigationStack {
+            List {
+                if hasPick {
+                    Section {
+                        Label("This track uses your clip", systemImage: "checkmark.circle.fill")
+                            .foregroundStyle(.green)
+                        Button("Remove Clip", role: .destructive) {
+                            CanvasStore.clear(for: videoId)
+                            CanvasService.shared.forget(videoId: videoId)
+                            hasPick = false
+                        }
+                    } header: {
+                        Text("Current")
+                    }
+                }
+
+                Section {
+                    PhotosPicker(selection: $pickedItem, matching: .videos) {
+                        HStack {
+                            Label("Choose from Photos…", systemImage: "photo.on.rectangle")
+                            Spacer()
+                            if isImporting { ProgressView() }
+                        }
+                    }
+                } header: {
+                    Text("Your Video")
+                } footer: {
+                    Text("The video is copied into the app, so it keeps playing after the original is deleted.")
+                }
+
+                Section {
+                    TextField("Song or album", text: $query)
+                        .textInputAutocapitalization(.never)
+                        .autocorrectionDisabled()
+                        .submitLabel(.search)
+                        .onSubmit { Task { await search() } }
+
+                    Button {
+                        Task { await search() }
+                    } label: {
+                        HStack {
+                            Text("Search Catalogue")
+                            Spacer()
+                            if isSearching { ProgressView() }
+                        }
+                    }
+                    .disabled(query.trimmingCharacters(in: .whitespaces).count < 2 || isSearching)
+                } header: {
+                    Text("Search")
+                } footer: {
+                    Text("Apple Music's motion artwork for “\(title)”.")
+                }
+
+                if !candidates.isEmpty {
+                    Section("Results") {
+                        ForEach(candidates) { candidate in
+                            Button {
+                                CanvasStore.setRemote(candidate.video, for: videoId)
+                                CanvasService.shared.forget(videoId: videoId)
+                                hasPick = true
+                                dismiss()
+                            } label: {
+                                candidateRow(candidate)
+                            }
+                            .buttonStyle(.plain)
+                        }
+                    }
+                } else if hasSearched, !isSearching {
+                    Section {
+                        Text("Nothing with motion artwork for that query.")
+                            .foregroundStyle(.secondary)
+                    }
+                }
+
+                if let errorMessage {
+                    Section {
+                        Text(errorMessage).foregroundStyle(.red)
+                    }
+                }
+            }
+            .navigationTitle("Canvas")
+            .navigationBarTitleDisplayMode(.inline)
+            .toolbar {
+                ToolbarItem(placement: .confirmationAction) {
+                    Button("Done") { dismiss() }
+                }
+            }
+            .onAppear { hasPick = CanvasStore.hasPick(for: videoId) }
+            .onChange(of: pickedItem) { _, item in
+                guard let item else { return }
+                Task { await importVideo(item) }
+            }
+        }
+        .appSheetChrome()
+    }
+
+    private func candidateRow(_ candidate: CanvasCandidate) -> some View {
+        HStack(spacing: 12) {
+            AsyncImage(url: candidate.preview) { image in
+                image.resizable().scaledToFill()
+            } placeholder: {
+                Color.secondary.opacity(0.15)
+            }
+            .frame(width: 52, height: 52)
+            .clipShape(RoundedRectangle(cornerRadius: 8))
+
+            VStack(alignment: .leading, spacing: 2) {
+                Text(candidate.title).font(.body).lineLimit(1)
+                Text(candidate.artist).font(.caption).foregroundStyle(.secondary).lineLimit(1)
+            }
+            Spacer(minLength: 0)
+        }
+        .contentShape(Rectangle())
+    }
+
+    private func search() async {
+        isSearching = true
+        errorMessage = nil
+        defer {
+            isSearching = false
+            hasSearched = true
+        }
+        candidates = await CanvasSearch.albums(matching: query)
+    }
+
+    private func importVideo(_ item: PhotosPickerItem) async {
+        isImporting = true
+        errorMessage = nil
+        defer { isImporting = false }
+
+        do {
+            guard let video = try await item.loadTransferable(type: PickableVideo.self) else {
+                errorMessage = "That video could not be read."
+                return
+            }
+            try CanvasStore.importVideo(from: video.url, for: videoId)
+            try? FileManager.default.removeItem(at: video.url)
+            CanvasService.shared.forget(videoId: videoId)
+            hasPick = true
+            dismiss()
+        } catch {
+            errorMessage = "Import failed: \(error.localizedDescription)"
+        }
+    }
+}
+
+/// A Photos video, copied out of the picker's sandbox before it disappears.
+struct PickableVideo: Transferable {
+    let url: URL
+
+    static var transferRepresentation: some TransferRepresentation {
+        FileRepresentation(contentType: .movie) { video in
+            SentTransferredFile(video.url)
+        } importing: { received in
+            let copy = FileManager.default.temporaryDirectory
+                .appendingPathComponent("canvas-\(UUID().uuidString).mov")
+            if FileManager.default.fileExists(atPath: copy.path) {
+                try FileManager.default.removeItem(at: copy)
+            }
+            try FileManager.default.copyItem(at: received.file, to: copy)
+            return PickableVideo(url: copy)
+        }
+    }
+}
diff --git a/Trop/Canvas/CanvasSearch.swift b/Trop/Canvas/CanvasSearch.swift
new file mode 100644
index 0000000..b63de7b
--- /dev/null
+++ b/Trop/Canvas/CanvasSearch.swift
@@ -0,0 +1,111 @@
+//
+//  CanvasSearch.swift
+//  Trop
+//
+//  Catalogue search for the manual picker: every album Apple has motion
+//  artwork for, with a still and a playable clip. Same host and token as the
+//  automatic source, but it returns the whole list instead of the best guess.
+//
+
+import Foundation
+
+struct CanvasCandidate: Identifiable, Hashable {
+    let id: String
+    let title: String
+    let artist: String
+    let video: URL
+    let preview: URL?
+}
+
+enum CanvasSearch {
+    static func albums(matching query: String, storefront: String = "us") async -> [CanvasCandidate] {
+        let term = query.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard term.count > 1 else { return [] }
+
+        var components = URLComponents(string: "https://amp-api.music.apple.com/v1/catalog/\(storefront)/search")!
+        components.queryItems = [
+            URLQueryItem(name: "term", value: term),
+            URLQueryItem(name: "types", value: "albums"),
+            URLQueryItem(name: "limit", value: "25"),
+            URLQueryItem(name: "extend", value: "editorialVideo")
+        ]
+        guard let url = components.url else { return [] }
+
+        for attempt in 0..<2 {
+            guard let token = try? await AppleWebToken.shared.token(forceRefresh: attempt > 0) else { continue }
+            var request = URLRequest(url: url)
+            request.timeoutInterval = 12
+            request.setValue("Bearer \(token)", forHTTPHeaderField: "Authorization")
+            request.setValue("https://music.apple.com", forHTTPHeaderField: "Origin")
+            request.setValue(CanvasHTTP.userAgent, forHTTPHeaderField: "User-Agent")
+
+            guard let data = try? await CanvasHTTP.data(request),
+                  let response = try? JSONDecoder().decode(Response.self, from: data) else { continue }
+
+            return (response.results.albums?.data ?? []).compactMap { album in
+                guard let clip = album.attributes.editorialVideo?.best,
+                      let video = URL(string: clip) else { return nil }
+                return CanvasCandidate(
+                    id: album.id,
+                    title: album.attributes.name,
+                    artist: album.attributes.artistName,
+                    video: video,
+                    preview: still(album.attributes.editorialVideo)
+                )
+            }
+        }
+        return []
+    }
+
+    /// The catalogue ships stills as `{w}x{h}bb.jpg` templates.
+    private static func still(_ motion: EditorialVideo?) -> URL? {
+        guard let template = motion?.previewTemplate else { return nil }
+        let sized = template.replacingOccurrences(of: "{w}", with: "300")
+            .replacingOccurrences(of: "{h}", with: "300")
+        return URL(string: sized)
+    }
+
+    // MARK: - Response
+
+    private struct Response: Decodable {
+        struct Results: Decodable { let albums: Listing? }
+        struct Listing: Decodable { let data: [Album] }
+        struct Album: Decodable {
+            let id: String
+            let attributes: Attributes
+        }
+        struct Attributes: Decodable {
+            let name: String
+            let artistName: String
+            let editorialVideo: EditorialVideo?
+        }
+    }
+}
+
+/// Apple's motion artwork block: one video and one still per aspect.
+struct EditorialVideo: Decodable {
+    struct Variant: Decodable {
+        let video: String?
+        let previewFrame: Frame?
+    }
+    struct Frame: Decodable { let url: String? }
+
+    let motionDetailTall: Variant?
+    let motionDetailSquare: Variant?
+    let motionTall: Variant?
+    let motionSquare: Variant?
+
+    var best: String? {
+        motionDetailTall?.video
+            ?? motionDetailSquare?.video
+            ?? motionTall?.video
+            ?? motionSquare?.video
+    }
+
+    var previewTemplate: String? {
+        motionDetailSquare?.previewFrame?.url
+            ?? motionDetailTall?.previewFrame?.url
+            ?? motionSquare?.previewFrame?.url
+            ?? motionTall?.previewFrame?.url
+    }
+}
diff --git a/Trop/Canvas/CanvasService.swift b/Trop/Canvas/CanvasService.swift
new file mode 100644
index 0000000..63750ac
--- /dev/null
+++ b/Trop/Canvas/CanvasService.swift
@@ -0,0 +1,261 @@
+//
+//  CanvasService.swift
+//  Trop
+//
+//  The short looping video behind a song — what Spotify calls Canvas.
+//  Two sources sit behind `CanvasSource`: Spotify's own clips, which need the
+//  listener's session cookie (see SpotifyCanvasSource), and Apple Music's motion
+//  artwork, which needs no account and covers every track Spotify has no clip
+//  for. The service walks them in order and stops at the first clip.
+//
+
+import Foundation
+
+enum CanvasError: Error {
+    case unavailable
+}
+
+// MARK: - Source
+
+protocol CanvasSource: Sendable {
+    var name: String { get }
+    func canvasURL(title: String, artist: String, album: String?) async throws -> URL?
+}
+
+/// Apple Music's animated artwork: two HLS clips per album (square and 3:4).
+struct AppleMotionCanvas: CanvasSource {
+    let name = "Apple Music"
+    /// Apple's catalogue is reachable from one storefront; art is the same.
+    var storefront = "us"
+
+    func canvasURL(title: String, artist: String, album: String?) async throws -> URL? {
+        guard !title.isEmpty, !artist.isEmpty else { return nil }
+
+        var components = URLComponents(string: "https://amp-api.music.apple.com/v1/catalog/\(storefront)/search")!
+        components.queryItems = [
+            URLQueryItem(name: "term", value: "\(title) \(artist)"),
+            URLQueryItem(name: "types", value: "albums"),
+            URLQueryItem(name: "limit", value: "10"),
+            URLQueryItem(name: "extend", value: "editorialVideo")
+        ]
+        guard let url = components.url else { throw CanvasError.unavailable }
+
+        for attempt in 0..<2 {
+            let token = try await AppleWebToken.shared.token(forceRefresh: attempt > 0)
+            var request = URLRequest(url: url)
+            request.timeoutInterval = 12
+            request.setValue("Bearer \(token)", forHTTPHeaderField: "Authorization")
+            request.setValue("https://music.apple.com", forHTTPHeaderField: "Origin")
+            request.setValue(CanvasHTTP.userAgent, forHTTPHeaderField: "User-Agent")
+
+            guard let data = try? await CanvasHTTP.data(request),
+                  let search = try? JSONDecoder().decode(Search.self, from: data) else { continue }
+
+            let albums = search.results.albums?.data ?? []
+            guard let best = bestAlbum(in: albums, title: title, artist: artist, album: album),
+                  let motion = best.attributes.editorialVideo?.bestURL else {
+                return nil
+            }
+            return URL(string: motion)
+        }
+        throw CanvasError.unavailable
+    }
+
+    /// The album that actually holds the track: same album name when we know it,
+    /// the artist matching, and never a tribute/karaoke release.
+    private func bestAlbum(in albums: [Search.Album], title: String, artist: String, album: String?) -> Search.Album? {
+        let wantedAlbum = normalized(album)
+        let wantedArtist = normalized(artist)
+
+        func score(_ album: Search.Album) -> Double {
+            var value = 0.0
+            let name = normalized(album.attributes.name)
+            let owner = normalized(album.attributes.artistName)
+            if !wantedAlbum.isEmpty, name == wantedAlbum { value += 3 }
+            if owner == wantedArtist { value += 4 }
+            if owner.contains(wantedArtist) || wantedArtist.contains(owner) { value += 2 }
+            if album.attributes.editorialVideo == nil { value -= 6 }
+            if name.contains("karaoke") || name.contains("tribute") || name.contains("instrumental") { value -= 4 }
+            if name.contains("single") || name == normalized(title) { value -= 1 }
+            return value
+        }
+
+        return albums
+            .filter { $0.attributes.editorialVideo != nil }
+            .max { score($0) < score($1) }
+    }
+
+    private func normalized(_ text: String?) -> String {
+        guard let text else { return "" }
+        let lowered = text.lowercased()
+        let allowed = lowered.unicodeScalars.filter { CharacterSet.alphanumerics.contains($0) || $0 == " " }
+        return String(String.UnicodeScalarView(allowed))
+            .trimmingCharacters(in: .whitespaces)
+    }
+
+    // MARK: Response
+
+    private struct Search: Decodable {
+        struct Results: Decodable {
+            let albums: Listing?
+        }
+
+        struct Listing: Decodable {
+            let data: [Album]
+        }
+
+        struct Album: Decodable {
+            let id: String
+            let attributes: Attributes
+        }
+
+        struct Attributes: Decodable {
+            let name: String
+            let artistName: String
+            let editorialVideo: EditorialVideo?
+        }
+
+        struct EditorialVideo: Decodable {
+            let motionTallVideo3x4: Clip?
+            let motionDetailTall: Clip?
+            let motionSquareVideo1x1: Clip?
+            let motionDetailSquare: Clip?
+
+            /// Portrait first: the player is a phone screen.
+            var bestURL: String? {
+                for clip in [motionTallVideo3x4, motionDetailTall, motionSquareVideo1x1, motionDetailSquare] {
+                    if let video = clip?.video, !video.isEmpty { return video }
+                }
+                return nil
+            }
+        }
+
+        struct Clip: Decodable {
+            let video: String?
+        }
+
+        let results: Results
+    }
+}
+
+// MARK: - Apple's web token
+
+/// Apple's web player token, scraped from its own bundle the way the web clients
+/// do it: no account, good for a while, refreshed when the API rejects it.
+actor AppleWebToken {
+    static let shared = AppleWebToken()
+
+    private var token: String?
+    private var issuedAt: Date?
+    /// Apple's token lives for hours; refreshing early keeps a long session safe.
+    private let lifetime: TimeInterval = 45 * 60
+
+    func token(forceRefresh: Bool) async throws -> String {
+        if !forceRefresh, let token, let issuedAt, Date().timeIntervalSince(issuedAt) < lifetime {
+            return token
+        }
+        let fresh = try await scrape()
+        token = fresh
+        issuedAt = Date()
+        return fresh
+    }
+
+    private func scrape() async throws -> String {
+        let page = try await CanvasHTTP.data(URLRequest(url: URL(string: "https://music.apple.com/us/new")!))
+        guard let html = String(data: page, encoding: .utf8),
+              let script = html.range(of: #"/assets/index~[^"]+\.js"#, options: .regularExpression),
+              let scriptURL = URL(string: "https://music.apple.com" + html[script]) else {
+            throw CanvasError.unavailable
+        }
+
+        let bundle = try await CanvasHTTP.data(URLRequest(url: scriptURL))
+        guard let source = String(data: bundle, encoding: .utf8),
+              let match = source.range(of: #"eyJ[A-Za-z0-9_-]+\.eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+"#,
+                                       options: .regularExpression) else {
+            throw CanvasError.unavailable
+        }
+        return String(source[match])
+    }
+}
+
+// MARK: - Service
+
+/// Caches what it found, remembers what it did not, and never runs two lookups
+/// for the same track at once.
+@MainActor
+final class CanvasService {
+    static let shared = CanvasService()
+
+    /// Spotify's own clips when a session cookie is set, Apple's motion
+    /// artwork for everything else — the second source needs no account.
+    private var sources: [CanvasSource] {
+        SpotifyCanvasSettings.isConfigured
+            ? [SpotifyCanvas(), AppleMotionCanvas()]
+            : [AppleMotionCanvas()]
+    }
+    private var hits: [String: URL] = [:]
+    /// Tracks without motion artwork: skip them for this session.
+    private var misses: Set<String> = []
+    private var running: [String: Task<URL?, Never>] = [:]
+
+    func canvas(videoId: String, title: String, artist: String, album: String?) async -> URL? {
+        // A clip the listener picked by hand wins over both sources: it is the
+        // only way to give a track a clip when neither service has one.
+        if !videoId.isEmpty, let picked = CanvasStore.url(for: videoId) { return picked }
+        guard !videoId.isEmpty, !title.isEmpty, !artist.isEmpty else { return nil }
+        if let hit = hits[videoId] { return hit }
+        if misses.contains(videoId) { return nil }
+        if let running = running[videoId] { return await running.value }
+
+        let task = Task<URL?, Never> { [sources] in
+            for source in sources {
+                guard let url = (try? await source.canvasURL(title: title, artist: artist, album: album)) ?? nil else { continue }
+                return url
+            }
+            return nil
+        }
+        running[videoId] = task
+        let found = await task.value
+        running[videoId] = nil
+
+        if let found {
+            if hits.count > 200 { hits.removeAll() }
+            hits[videoId] = found
+        } else {
+            misses.insert(videoId)
+        }
+        return found
+    }
+
+    /// Drops every cached answer: after the Spotify cookie changes, tracks that
+    /// read as "nothing found" deserve a second look.
+    func forgetAll() {
+        hits.removeAll()
+        misses.removeAll()
+    }
+
+    /// Drops a track from the "nothing found" list, e.g. after a track was added.
+    func forget(videoId: String) {
+        misses.remove(videoId)
+        hits[videoId] = nil
+    }
+}
+
+// MARK: - HTTP
+
+enum CanvasHTTP {
+    static let userAgent = "Mozilla/5.0 (iPhone; CPU iPhone OS 18_0 like Mac OS X) "
+        + "AppleWebKit/605.1.15 (KHTML, like Gecko) Version/18.0 Mobile/15E148 Safari/604.1"
+
+    static func data(_ request: URLRequest) async throws -> Data {
+        var request = request
+        if request.value(forHTTPHeaderField: "User-Agent") == nil {
+            request.setValue(userAgent, forHTTPHeaderField: "User-Agent")
+        }
+        let (data, response) = try await URLSession.shared.data(for: request)
+        guard let http = response as? HTTPURLResponse, (200..<300).contains(http.statusCode) else {
+            throw CanvasError.unavailable
+        }
+        return data
+    }
+}
